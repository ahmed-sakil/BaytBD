generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(ADMIN)
  avatar       String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  articles     NewsArticle[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  sku            String         @unique
  price          Float
  discountPrice  Float?
  stockQuantity  Int            @default(0)
  unit           String         @default("kg")
  description    String
  specifications Json?
  benefits       Json?
  isFeatured     Boolean        @default(false)
  isActive       Boolean        @default(true)
  categoryId     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderItems     OrderItem[]
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images         ProductImage[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String
  city            String
  subtotal        Float
  shippingFee     Float         @default(0)
  totalAmount     Float
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  transactionId   String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model DevelopmentProject {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  projectType    ProjectType      @default(RESIDENTIAL)
  status         ProjectStatus    @default(ONGOING)
  location       String
  city           String           @default("Dhaka")
  landArea       String?
  numberOfFloors String?
  units          String?
  parking        String?
  completionDate String?
  featuredImage  String
  description    String
  features       Json?
  facilities     Json?
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  images         ProjectImage[]
  inquiries      ProjectInquiry[]
}

model ProjectImage {
  id        String             @id @default(uuid())
  projectId String
  imageUrl  String
  caption   String?
  category  String             @default("GALLERY")
  createdAt DateTime           @default(now())
  project   DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectInquiry {
  id        String             @id @default(uuid())
  projectId String
  name      String
  email     String
  phone     String
  message   String
  status    InquiryStatus      @default(NEW)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ITService {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  shortDesc    String
  fullDesc     String
  iconName     String   @default("Code2")
  features     Json?
  technologies Json?
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ITProject {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  industry      String
  clientName    String?
  technologies  Json?
  featuredImage String
  summary       String
  challenges    String?
  solutions     String?
  results       String?
  liveUrl       String?
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id         String     @id @default(uuid())
  name       String
  role       String
  department Department @default(CORPORATE)
  bio        String?
  image      String?
  skills     Json?
  socials    Json?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model NewsArticle {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  category      Department @default(CORPORATE)
  content       String
  excerpt       String
  featuredImage String
  isPublished   Boolean    @default(true)
  authorId      String?
  publishedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  author        User?      @relation(fields: [authorId], references: [id])
}

model JobPost {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  department     Department       @default(CORPORATE)
  location       String           @default("Dhaka, Bangladesh")
  employmentType String           @default("Full-time")
  description    String
  requirements   Json?
  benefits       Json?
  deadline       DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
}

model JobApplication {
  id            String       @id @default(uuid())
  jobId         String
  applicantName String
  email         String
  phone         String
  resumeUrl     String?
  coverLetter   String?
  status        JobAppStatus @default(NEW)
  createdAt     DateTime     @default(now())
  job           JobPost      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model GeneralInquiry {
  id               String        @id @default(uuid())
  name             String
  email            String
  phone            String?
  company          String?
  departmentTarget Department    @default(CORPORATE)
  subject          String
  message          String
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model CompanyInfo {
  id             String   @id @default(uuid())
  companyName    String   @default("BaytBD Group of Companies")
  tagline        String?  @default("One Group. Three Businesses. One Digital Ecosystem.")
  description    String?  @default("Building national infrastructure in ethical agriculture, premier real estate, and enterprise software.")
  logoUrl        String?
  iconUrl        String?
  primaryPhone   String   @default("+880 1800-BAYTBD")
  secondaryPhone String?  @default("+880 2 8878901")
  primaryEmail   String   @default("info@baytbd.com")
  supportEmail   String?  @default("support@baytbd.com")
  address        String   @default("Bayt Tower, Level 14, Road 71, Gulshan-2, Dhaka-1212, Bangladesh")
  city           String   @default("Dhaka")
  country        String   @default("Bangladesh")
  businessHours  String?  @default("Sun - Thu: 9:00 AM - 6:00 PM")
  facebookUrl    String?  @default("https://facebook.com")
  linkedinUrl    String?  @default("https://linkedin.com")
  twitterUrl     String?  @default("https://x.com")
  instagramUrl   String?  @default("https://instagram.com")
  youtubeUrl     String?  @default("https://youtube.com")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  ORDER_MANAGER
  BUSINESS_MANAGER
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  SHOPPING_MALL
  MIXED_USE
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
  CARD
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum JobAppStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

enum Department {
  EXECUTIVE
  AGRO
  DEVELOPMENT
  IT
  CORPORATE
  PARTNERSHIP
}
