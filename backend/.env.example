# ===================================================
# BaytBD Backend - Production Environment Variables
# ===================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=production

# Database Connection String (PostgreSQL)
# Standard Production (Neon, Supabase, AWS RDS, Railway, DigitalOcean):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host:5432/baytbd?sslmode=require"

# JWT Authentication
JWT_SECRET="replace_with_a_long_random_64_character_secret_key_in_production"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origins for CORS (comma-separated if multiple domains)
# Example: FRONTEND_URL="https://baytbd.com,https://www.baytbd.com"
FRONTEND_URL="https://baytbd.com,https://www.baytbd.com,http://localhost:5173"

# Cloudinary Storage Credentials (for image & document uploads)
CLOUDINARY_CLOUD_NAME="zagrmuva"
CLOUDINARY_API_KEY="892572139489195"
CLOUDINARY_API_SECRET="7ZRdyUJdt4Aj98G_HnR28uYnM7c"
